{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Bash-Debug Launch Current File",
            "type": "bashdb",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "program": "${file}",
            "terminalKind": "integrated"
        },
        {
            "name": "Bash-Debug (yana-tool test)",
            "type": "bashdb",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "program": "${workspaceFolder}/yana-tool.sh",
            "args": [
                "test",
                "-failfast",
                "-source",
                "${relativeFile}"
            ],
            "terminalKind": "integrated"
        },
        // {
        //     "name": "Bash-Debug (yana-test)",
        //     "type": "bashdb",
        //     "request": "launch",
        //     "cwd": "${workspaceFolder}",
        //     "program": "${workspaceFolder}/yana-test.sh",
        //     "args": [
        //         "-testfile",
        //         "${relativeFile}"
        //     ],
        //     "terminalKind": "integrated"
        // },
        {
            "name": "PowerShell Launch Current File",
            "type": "PowerShell",
            "request": "launch",
            "script": "${file}",
            "cwd": "${workspaceFolder}",
            "createTemporaryIntegratedConsole": true
        },
        {
            "name": "PowerShell (yana-test)",
            "type": "PowerShell",
            "request": "launch",
            "script": "${workspaceFolder}/yana-test.ps1",
            "cwd": "${workspaceFolder}",
            "args": [
                "-testfile",
                "${relativeFile}"
            ],
            "createTemporaryIntegratedConsole": true
        }
    ]
}
