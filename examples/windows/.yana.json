{
  "requires": [
    "powershell"
  ],
  "params": {
    "service_name": "WinRM",
    "app_directory": "C:\\YanaApp\\logs",
    "log_file": "${param:app_directory}\\app.log"
  },
  "steps": [
    {
      "id": "create_log_dir",
      "name": "Create Application Log Directory",
      "action": "dir:create",
      "args": {
        "Path": "${param:app_directory}"
      }
    },
    {
      "name": "Write Application Log File",
      "action": "file:write",
      "args": {
        "Path": "${param:log_file}",
        "Content": "Application started at ${var:time}\nUser: ${env:USERNAME}\nLog directory: ${output:create_log_dir}\n"
      }
    },
    {
      "name": "Ensure WinRM Service is Started",
      "action": "service:start",
      "args": {
        "Name": "${param:service_name}"
      }
    }
  ]
}
