{
  "requires": [
    "powershell"
  ],
  "params": {
    "app_dir": "c:/yana_demo",
    "config_file": "${param:app_dir}/config.env",
    "marker_file": "${param:app_dir}/status.txt",
    "service_port": "8080"
  },
  "vars": {
    "marker_file_content": {
      "fn": "file:read",
      "args": {
        "path": "${param:marker_file}"
      }
    },
    "user": {
      "fn": "sys:user",
      "cached": true
    },
    "group": {
      "fn": "sys:group"
    },
    "owner": "${var:user}:${var:group}",
    "i": 1,
    "a": [1, 2, 3],
    "b": true,
    "s": "s"
  },
  "steps": [
    {
      "name": "Create marker file",
      "apply": "file:create",
      "args": {
        "path": "${param:marker_file}",
        "content": "STATUS=ACTIVE"
      }
    },
    {
      "name": "Ensure application configuration exists",
      "apply": "file:write",
      "args": {
        "path": "${param:config_file}",
        "content": "marker_file=${var:marker_file_content}\nPORT=${param:service_port}\nUSER=${var:user}"
      }
    }
  ]
}
